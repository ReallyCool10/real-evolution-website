{
  "name": "real-intel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/server.js",
    "ingest": "node server/ingest.js",
    "ingest:all": "node server/ingest.js --ccod-limit=1000000",
    "ingest:full": "node server/ingest-full.js",
    "geocode": "node server/apply-exact-postcodes.js",
    "summaries": "node server/build-outcodes.js && node server/build-proprietor-summary.js",
    "download:uprn": "node server/download-nsul.js",
    "ingest:uprn": "node server/ingest-nsul.js",
    "client": "vite",
    "dev": "node dev.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test \"server/**/*.test.js\""
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "proj4": "^2.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.1"
  }
}
