---
// Numbered reference list. Items are passed as <li> children; each is numbered "[n]"
// automatically and can carry an id (e.g. "cit-1") for in-text links to jump to.
type Props = { title?: string };
const { title = 'Citations & Sources' } = Astro.props;
---

<section class="citations" aria-label={title}>
  <h2>{title}</h2>
  <ol>
    <slot />
  </ol>
</section>

<style>
  .citations {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.1rem;
    color: var(--text-3);
  }

  ol {
    padding: 0;
    list-style: none;
    counter-reset: cite;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-4);
  }

  ol :global(li) {
    counter-increment: cite;
    position: relative;
    margin-bottom: 0.6rem;
    padding-left: 2.5rem;
  }

  ol :global(li)::before {
    content: '[' counter(cite) ']';
    position: absolute;
    left: 0;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--gold);
  }

  ol :global(li:target) {
    color: var(--text-2);
  }

  ol :global(a) {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.4);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  ol :global(a:hover) {
    color: var(--gold);
    border-bottom: 1px solid var(--gold);
  }

  ol :global(.source) {
    font-style: italic;
    color: rgba(255, 255, 255, 0.4);
  }
</style>
