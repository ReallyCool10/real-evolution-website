---
// Home page photo backdrop: a CSS-only crossfade with a slow zoom (no timers, no re-renders).
// Images are resized and re-encoded at build time. Only the first slide loads with the page;
// the other two get their srcset after the load event, so they never compete with it.
import { getImage } from 'astro:assets';
import slide1 from '../assets/BackgroundImage.jpg';
import slide2 from '../assets/BackgroundImage_2.jpg';
import slide3 from '../assets/BackgroundImage_3.jpg';

const WIDTHS = [768, 1280, 1920, 2560];
const SIZES = '100vw';

const slides = await Promise.all(
  [slide1, slide2, slide3].map(async src => {
    const [avif, webp, fallback] = await Promise.all([
      getImage({ src, format: 'avif', widths: WIDTHS, sizes: SIZES, quality: 55 }),
      getImage({ src, format: 'webp', widths: WIDTHS, sizes: SIZES, quality: 70 }),
      getImage({ src, format: 'jpg', width: 1920, quality: 72 }),
    ]);
    return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, fallback: fallback.src };
  }),
);
---

<div class="hero-backdrop" aria-hidden="true">
  {slides.map((slide, i) => {
    const eager = i === 0;
    return (
      <picture class="slide">
        <source type="image/avif" sizes={SIZES} srcset={eager ? slide.avif : undefined} data-srcset={eager ? undefined : slide.avif} />
        <source type="image/webp" sizes={SIZES} srcset={eager ? slide.webp : undefined} data-srcset={eager ? undefined : slide.webp} />
        <img
          src={eager ? slide.fallback : undefined}
          data-src={eager ? undefined : slide.fallback}
          alt=""
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
        />
      </picture>
    );
  })}
</div>

<script is:inline>
  // Promote the deferred slides once the page (and slide 1) has finished loading.
  addEventListener('load', () => {
    const idle = window.requestIdleCallback || (cb => setTimeout(cb, 200));
    idle(() => {
      document.querySelectorAll('.hero-backdrop [data-srcset]').forEach(el => { el.srcset = el.dataset.srcset; });
      document.querySelectorAll('.hero-backdrop img[data-src]').forEach(el => { el.src = el.dataset.src; });
    });
  });
</script>

<style>
  /* 33s cycle: each slide holds ~8s, then crossfades over 3s while zooming to 1.08x.
     Slide 1 starts part-way through its cycle so it is fully visible at first paint. */
  .hero-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  .slide,
  .slide img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide img {
    object-fit: cover;
    animation: zoom 33s ease-out infinite;
    animation-delay: inherit;
    will-change: transform;
  }

  .slide {
    opacity: 0;
    animation: crossfade 33s ease-in-out infinite backwards;
  }

  .slide:nth-child(1) {
    opacity: 1;
    animation-delay: -3s;
  }

  .slide:nth-child(2) {
    animation-delay: 8s;
  }

  .slide:nth-child(3) {
    animation-delay: 19s;
  }

  @keyframes crossfade {
    0% { opacity: 0; }
    9.09% { opacity: 1; }
    33.33% { opacity: 1; }
    42.42% { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes zoom {
    0% { transform: scale(1); }
    42.42% { transform: scale(1.08); }
    100% { transform: scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide img {
      animation: none;
    }
  }
</style>
