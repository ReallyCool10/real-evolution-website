---
// Shared card, title and subtitle for every chart.
type Props = { title: string; subtitle?: string };
const { title, subtitle } = Astro.props;
---

<figure class="card chart">
  <figcaption>
    <span class="title">{title}</span>
    {subtitle && <span class="subtitle">{subtitle}</span>}
  </figcaption>
  <slot />
</figure>

<style>
  .chart {
    margin: 2.5rem 0;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3.5vw, 1.3rem);
    line-height: 1.3;
    color: var(--text);
  }

  .subtitle {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Explanatory note beneath a chart (passed in through the slot). */
  .chart :global(.chart-note) {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-3);
  }

  .chart :global(.chart-note strong) {
    color: var(--text);
  }
</style>
